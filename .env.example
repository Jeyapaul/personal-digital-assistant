# Copy values into your shell environment or a private ignored .env file.
# Never put provider tokens or OAuth client secrets in this repository.

PERSONAL_ASSISTANT_DATA_DIR=$HOME/.hermes/personal-assistant-data
HERMES_AGENT_ROOT=$HOME/.hermes/hermes-agent
PDA_MAIL_SOURCES=gmail,microsoft
# Opt in only after reviewing the separate management OAuth scopes.
PDA_MAIL_MUTATION_ENABLED=false
PDA_APPROVAL_EXPIRY_HOURS=0
# Only explicitly reviewed HTTPS List-Unsubscribe hosts may be contacted.
PDA_UNSUBSCRIBE_ALLOWED_HOSTS=
# Load this model in LM Studio before enabling the container deployment.
PDA_MODEL=pda-qwen30
PDA_LMSTUDIO_CONTEXT=32768
